{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if ne .Title .Site.Title }}in {{ .Title }} {{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>{{ with .Site.LanguageCode }}
    <language>{{ . }}</language>{{ end }}{{ with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{ if eq .Kind "taxonomy" }}
      {{ range .Data.Terms.Alphabetical }}
        {{ $pages := where .Pages "Section" "ne" "notes" }}
        {{ if gt (len $pages) 0 }}
    <item>
      <title>{{ .Page.Title }}</title>
      <link>{{ .Page.Permalink }}</link>
      <guid>{{ .Page.Permalink }}</guid>
    </item>
        {{ end }}
      {{ end }}
    {{ else }}
      {{ range (where .Data.Pages "Section" "ne" "notes").ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | html }}</description>
    </item>
      {{ end }}
    {{ end }}
  </channel>
</rss>
